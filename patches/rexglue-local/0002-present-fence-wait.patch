index 0000000..0fa7106
--- /dev/null
+++ b/include/rex/ui/vulkan/present_wait_stats.h
@@ -0,0 +1,29 @@
+#pragma once
+/**
+ ******************************************************************************
+ * ReXGlue runtime - local patch for gh3-nx (F3.1 of the 60 FPS plan).
+ ******************************************************************************
+ *
+ * Accumulates, per window, how long the presenter's own submission trackers
+ * (the paint submission ring and the guest output refresher) spend in
+ * vkWaitForFences. Trackers that haven't been marked with
+ * SetPresentFenceWaitAccounting(true) don't contribute, so the command
+ * processor fences and the renderer's work slots stay out of the number.
+ */
+
+#include <cstdint>
+
+namespace rex {
+namespace ui {
+namespace vulkan {
+
+void AddPresentFenceWaitNs(uint64_t ns);
+
+// Reads and resets the window atomically: the runtime's 10-second report
+// measures the delta since its previous report. Returns the accumulated
+// nanoseconds; wait_count_out (optional) receives the number of waits.
+uint64_t ConsumePresentFenceWaitNs(uint64_t* wait_count_out);
+
+}  // namespace vulkan
+}  // namespace ui
+}  // namespace rex
