 #include <rex/ui/vulkan/presenter.h>
 #if REX_PLATFORM_SWITCH
 #include <rex/ui/surface_switch.h>
@@ -70,6 +71,30 @@ namespace rex {
 namespace ui {
 namespace vulkan {
 
+// gh3-nx F3.1: window of presenter fence waits, consumed by the runtime's 10-second report. Kept
+// apart from the command processor and the renderer's work slots, which never mark their trackers
+// with SetPresentFenceWaitAccounting.
+namespace {
+
+std::atomic<uint64_t> g_present_fence_wait_ns{0};
+std::atomic<uint64_t> g_present_fence_wait_count{0};
+
+}  // namespace
+
+void AddPresentFenceWaitNs(uint64_t ns) {
+  g_present_fence_wait_ns.fetch_add(ns, std::memory_order_relaxed);
+  g_present_fence_wait_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+uint64_t ConsumePresentFenceWaitNs(uint64_t* wait_count_out) {
+  const uint64_t wait_ns = g_present_fence_wait_ns.exchange(0, std::memory_order_relaxed);
+  const uint64_t wait_count = g_present_fence_wait_count.exchange(0, std::memory_order_relaxed);
+  if (wait_count_out) {
+    *wait_count_out = wait_count;
+  }
+  return wait_ns;
+}
+
